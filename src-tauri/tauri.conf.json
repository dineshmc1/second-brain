{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Second Brain",
  "version": "0.2.0",
  "identifier": "ai.secondbrain.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "frontendDist": "../frontend/out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Second Brain",
        "width": 1320,
        "height": 840,
        "minWidth": 920,
        "minHeight": 620,
        "center": true,
        "decorations": true,
        "resizable": true
      },
      {
        "label": "quick",
        "title": "Ask Second Brain",
        "url": "quick/index.html",
        "width": 620,
        "height": 210,
        "center": true,
        "visible": false,
        "alwaysOnTop": true,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true
      },
      {
        "label": "capture",
        "title": "Quick Capture",
        "url": "capture/index.html",
        "width": 560,
        "height": 270,
        "center": true,
        "visible": false,
        "alwaysOnTop": true,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8765; img-src 'self' asset: data: blob:; media-src 'self' blob: http://127.0.0.1:8765; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/second-brain-backend"],
    "resources": {
      "../backend/dist/second-brain-backend/_internal/": "_internal/"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["English"]
      }
    },
    "shortDescription": "Your private, local-first AI knowledge assistant",
    "longDescription": "Second Brain stores, searches, and answers from your personal knowledge with citations and temporal memory."
  }
}
